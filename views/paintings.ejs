<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>
    <p>Number of paintings: <%= db %></p>
    <br>
    <form  method="get">
        <input type="number" id="minYear" name="minYear">
        <button type="submit">Submit</button>
    </form>
    <br>
    <ul>
        <% paintings.forEach(painting => { %>
            <li><%= painting.title %> by <%= painting.painter %> (painted in <%= painting.painted_at %>)</li>
        <% }); %>
    </ul>
</body>
</html>